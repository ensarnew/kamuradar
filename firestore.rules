rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. İlanlar Koleksiyonu (Tüm kullanıcılar okuyabilir, sadece admin/backend yazar)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // 2. Kullanıcı Profili ve Abonelik Durumu
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Kullanıcı Alarmları (Hangi kullanıcı hangi ilanın zilini açtı?)
    match /user_alarms/{alarmId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }

    // 4. VIP Aile Abonelikleri ve Slotlar
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == resource.data.owner_user_id ||
        resource.data.family_members.hasAny([request.auth.uid])
      );
    }
  }
}
